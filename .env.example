# Local Supabase stack. `supabase start` prints these; `supabase status` re-prints them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). This CLI version no longer emits anon /
# service_role keys. Never prefix a secret key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
