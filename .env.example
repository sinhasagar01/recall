# Local Supabase stack. `supabase start` prints these; `supabase status` re-prints them.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...). This CLI version no longer emits anon /
# service_role keys. Never prefix a secret key with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only, from `supabase status` as SECRET_KEY. Used by the e2e seed script.
# Never give a secret key a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# The deterministic user the Playwright suite signs in as.
# Create it with: npm run seed:e2e
E2E_USER_EMAIL=e2e@recall.test
E2E_USER_PASSWORD=replace_me

# A second user that no spec ever writes to, so the empty-library spec cannot be
# defeated by rows another spec left behind. Its topics are cleared by the seed.
E2E_EMPTY_USER_EMAIL=e2e-empty@recall.test
E2E_EMPTY_USER_PASSWORD=replace_me

# A user seeded with exactly two topics, for the too-few-to-practice state.
E2E_FEW_USER_EMAIL=e2e-few@recall.test
E2E_FEW_USER_PASSWORD=replace_me

